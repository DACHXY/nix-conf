-void wl_copy_selection() { UNIMPLEMENTED }
+void wl_copy_selection()
+{
+	/*
+	 * warpd's drag mode leaves the dragged-over text in the primary
+	 * selection. Promote it to the clipboard -- this is what the X backend
+	 * achieves by synthesising Ctrl+Insert. Requires wl-clipboard
+	 * (wl-paste/wl-copy) on PATH.
+	 *
+	 * The caller releases the drag first, but the focused application
+	 * publishes the finished selection asynchronously, so give it a moment
+	 * before reading. timeout(1) guards against wl-paste blocking forever
+	 * when nothing owns the primary selection.
+	 */
+	system("sleep 0.2; timeout 2 wl-paste --primary | wl-copy");
+}
