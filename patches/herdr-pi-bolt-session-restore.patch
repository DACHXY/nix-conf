+/// Pi-Bolt (the harness this machine runs) ships its own herdr integration that
+/// identifies itself as `pi-bolt` / `herdr:pi-bolt`. It speaks exactly the `pi`
+/// integration protocol, so alias its source onto `herdr:pi`; the label is
+/// already canonicalised to `pi` by `normalize_reported_agent_label`.
+pub(super) fn normalize_reported_agent_source(source: &str) -> String {
+    let trimmed = source.trim();
+    if trimmed.eq_ignore_ascii_case("pi-bolt") || trimmed.eq_ignore_ascii_case("herdr:pi-bolt") {
+        "herdr:pi".to_string()
+    } else {
+        trimmed.to_string()
+    }
+}
