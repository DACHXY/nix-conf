  * *Note*: Wayland does not allow for global input handlers.
  * Input events can only be captured by a focused window :(.
  */
+/*
+ * Move the keyboard grab to `output`.
+ *
+ * A layer surface shown with output=NULL is attached by the compositor to
+ * whatever output happens to be active at that moment, and layer keyboard
+ * focus is only granted to a surface sitting on the active output. Once the
+ * cursor (and thus the active output) moves, the grab must be re-created on
+ * the new output or warpd stays mapped but deaf.
+ */
+void wl_input_move_keyboard_grab(struct wl_output *output)
+{
+	if (!input_pixel.wl_surface)
+		return;
+
+	surface_hide(&input_pixel);
+	surface_show(&input_pixel, output);
+}
+
