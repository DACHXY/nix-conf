 	if (!input_pixel.buf)
-		init_surface(&input_pixel, -1, -1, 1, 1, 1);
+		init_surface(&input_pixel, -1, -1, 10, 10, 1);
 
-	surface_show(&input_pixel, NULL);
+	surface_show(&input_pixel, active_screen->wl_output);
 }
 
